# Supabase (Project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (console.anthropic.com) - used server-side for coaching
ANTHROPIC_API_KEY=
# Optional model override
ANTHROPIC_MODEL=claude-sonnet-5-5

# YouTube Data API v3 key (free tier, Google Cloud Console). Optional:
# without it, the app falls back to YouTube search links.
YOUTUBE_API_KEY=
